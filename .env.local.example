# Unasked — environment configuration
#
# If NO provider key is set, the app runs in clearly-labeled Demo Mode
# (transparent rule-based checks, no AI call).
#
# Setting a key switches the app to Live AI mode. A present-but-invalid key
# surfaces a real error (it never silently falls back to Demo Mode).

# ---------------------------------------------------------------------------
# Google Gemini — OpenAI-compatible endpoint (recommended)
# ---------------------------------------------------------------------------
# 1. Create an API key at https://aistudio.google.com/apikey
# 2. Paste the key below (keep a real key only in .env.local, never in git).
# 3. Confirm the model name is available to your key; if unsure, use
#    gemini-2.0-flash.
OPENAI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Any other OpenAI-compatible provider also works via the same variables.
# Only ONE provider key is used; priority is GEMINI > OPENAI > OPENROUTER > GROQ.
# ---------------------------------------------------------------------------
# Apple/OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Explicit Gemini variables (equivalent to the OPENAI_* block above):
# GEMINI_API_KEY=...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-2.0-flash
#
# OpenRouter (free-tier models available):
# OPENROUTER_API_KEY=...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
#
# Groq (generous free tier):
# GROQ_API_KEY=...
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
